{
  "name": "@display-studio/vite-plugin-shopify-theme",
  "version": "0.4.2",
  "description": "A focused Vite 8 integration for Shopify themes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/display-design-studio/vite-plugin-shopify-theme.git"
  },
  "homepage": "https://display-design-studio.github.io/vite-plugin-shopify-theme/",
  "bugs": {
    "url": "https://github.com/display-design-studio/vite-plugin-shopify-theme/issues"
  },
  "keywords": [
    "vite-plugin",
    "vite",
    "shopify",
    "liquid",
    "hmr"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vite-shopify-theme": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "docs:dev": "vitepress docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration.test.ts",
    "playground:build": "npm --prefix playground/skeleton-theme run build",
    "playground:dev": "npm run build && npm --prefix playground/skeleton-theme run dev",
    "e2e:shopify": "npm run build && node scripts/e2e-shopify.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "theme:check": "npm --prefix playground/skeleton-theme exec -- shopify theme check --path playground/skeleton-theme",
    "compat:vite": "node scripts/check-compatibility.mjs vite",
    "compat:shopify": "node scripts/check-compatibility.mjs shopify",
    "compat:frameworks": "node scripts/check-frameworks.mjs all",
    "compat:consumer": "node scripts/check-consumer.mjs",
    "compat:vue": "node scripts/check-frameworks.mjs vue",
    "compat:react": "node scripts/check-frameworks.mjs react",
    "compat": "node scripts/check-compatibility.mjs all",
    "check": "npm run typecheck && npm test && npm run build && npm run docs:build && npm run playground:build && npm run pack:check && npm run theme:check",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.3",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
